cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "Noetiko Convergence"
abstract: >
  Noetiko Convergence is a Python toolkit for reproducible analysis and simulation of
  phase synchronization under noise, with a focus on scientifically auditable metrics,
  surrogate testing, and clear reporting artifacts for open science workflows.
authors:
  - family-names: "Kappe"
    given-names: "André"
    orcid: "https://orcid.org/0009-0001-2799-379X"
    affiliation: "Noetiko Research Division, Cologne, Germany"
license: "Apache-2.0"
repository-code: "https://github.com/Andre-Kappe-NOETIKO/Noetiko-convergence"
url: "https://github.com/Andre-Kappe-NOETIKO/Noetiko-convergence"
keywords:
  - "reproducibility"
  - "phase synchronization"
  - "Kuramoto model"
  - "stochastic dynamics"
  - "surrogate data"
  - "scientific computing"
  - "open science"
  - "metastability"
  - "coordination dynamics"
version: "0.1.1"

